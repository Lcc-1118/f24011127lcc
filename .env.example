# 复制为 .env 后按需修改。全部留空也能跑：系统自动切"规则大脑 + 检索兜底"模式，
# 演示（quickstart.py）、评测（evals/run_eval.py）、冒烟（scripts/smoke_e2e.py）在该模式下均 100% 通过。
# 注意：本文件里的变量名必须与 app/config.py 中的 _env("...") 完全一致。

# ---------------------------------------------------------------- LLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- 安全
# 生产必须改：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-change-me
JWT_TTL_HOURS=12

# ---------------------------------------------------------------- 存储与语料
REIMB_DATA_DIR=
REIMB_DB_PATH=
# 制度 Markdown 目录（默认 <项目>/data/policies）

# ---------------------------------------------------------------- 检索
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3
RRF_K=60

# ---------------------------------------------------------------- 智能体
MAX_AGENT_ROUNDS=5
HISTORY_ROUNDS=6

# ---------------------------------------------------------------- 种子账号
# 首次建库时写入；生产请改口令，并且不要用 run.py --reset
SEED_ADMIN_USER=admin
SEED_ADMIN_PWD=admin123
SEED_EMPLOYEE_USER=zhangwei
SEED_EMPLOYEE_PWD=emp123
